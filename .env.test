APP_ENV=test
APP_SECRET=testingsecretkey1234567890abcdef
APP_URL=http://localhost

DATABASE_URL="postgresql://test:test@testgator-db-test:5432/testgator_test?serverVersion=16&charset=utf8"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# LDAP not used in tests
LDAP_QUERY_STRING=ldap://localhost:3890
LDAP_BASE_DN=dc=default,dc=com
LDAP_ADMIN_UID=admin
LDAP_ADMIN_PASSWORD=test
LDAP_MUST_HAVE_GROUP=

# File storage — backed by the testgator-s3-test SeaweedFS container (see
# compose.yml and `make test`), so FileService actually exercises real S3
# calls (putObject/deleteObject/presigned URLs) instead of the unimplemented
# FILE_STORAGE_MODE=local path.
FILE_STORAGE_MODE=bucket
FILE_MAX_SIZE_MB=10
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://testgator-s3-test:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
# private bucket — signed-URL files (bug report attachments, etc.)
AWS_BUCKET=testgator-test-private
PUBLIC_URL_BUCKET=http://testgator-s3-test:8333/testgator-test-private
# public bucket — avatars, project images/banners
AWS_PUBLIC_BUCKET=testgator-test-public
PUBLIC_URL_PUBLIC_BUCKET=http://testgator-s3-test:8333/testgator-test-public

MAILER_DSN=null://null
MAILER_SENDER_ADDRESS=test@testgator.test

SENTRY_DSN=

PHP_CS_FIXER_IGNORE_ENV=1
